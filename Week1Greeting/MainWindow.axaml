<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Week1Greeting.MainWindow"
        Width="400"
        Height="300"
        Title="Week1Greeting">

    <StackPanel Margin="30" Spacing="20">

        <TextBox Name="txtName"/>

        <Label Name="lblMessage" Content=""/>

        <Button Name="btnHello" Content="Say hello" Click="btnHello_Click"/>
        <Button Name="btnClear" Content="Clear" Click="btnClear_Click"/>

    </StackPanel>

</Window>